# ── 24/7 Gap Intel ──
# AI analyst (optional). Without it, rule-based interpretations are used.
ANTHROPIC_API_KEY=
# INTEL_AI_MODEL=claude-opus-5-5
# Minutes between AI assessments (each one is a paid API call). Default 30.
# INTEL_AI_INTERVAL_MIN=30

# Durable sweep history (recommended on Vercel). Upstash Redis or Vercel KV REST credentials.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work.)
# Without these, history is a local file (INTEL_DATA_DIR, default ./.data) — or /tmp on Vercel (not durable).
# INTEL_HISTORY_MAX=2000

# Protects /api/intel/sweep, which a scheduler calls to keep the swarm running 24/7.
CRON_SECRET=
